{
  "name": "localogue",
  "version": "0.1.8",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm validate:data && pnpm validate:audit && pnpm lint && pnpm typecheck && pnpm build",
    "validate:data": "node scripts/validate-library.mjs",
    "library:init": "node scripts/init-private-library.mjs",
    "validate:audit": "node scripts/validate-audit.mjs"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.11.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "^19.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "typescript": "5.9.3"
  }
}
