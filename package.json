{
  "name": "localogue",
  "version": "0.1.24",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm desktop:clean:legacy && pnpm validate:data && pnpm validate:audit && pnpm validate:platform && pnpm validate:desktop && pnpm lint && pnpm typecheck && pnpm desktop:check && pnpm build",
    "validate:data": "node scripts/validate-library.mjs",
    "library:init": "node scripts/init-private-library.mjs",
    "validate:audit": "node scripts/validate-audit.mjs",
    "library:init:demo": "node scripts/init-private-library.mjs --demo",
    "validate:platform": "node scripts/validate-platform-boundaries.mjs",
    "validate:desktop": "node scripts/validate-desktop-boundaries.mjs",
    "desktop:dev": "pnpm --filter @localogue/desktop tauri:dev",
    "desktop:dev:release-data": "pnpm --filter @localogue/desktop tauri:dev:release-data",
    "desktop:typecheck": "pnpm --filter @localogue/desktop typecheck",
    "desktop:build:webview": "pnpm --filter @localogue/desktop build:webview",
    "desktop:check": "pnpm --filter @localogue/desktop check",
    "desktop:build": "pnpm --filter @localogue/desktop tauri:build",
    "desktop:doctor": "node scripts/check-tauri-prerequisites.mjs",
    "desktop:rust:check": "pnpm --filter @localogue/desktop rust:check",
    "desktop:clean:legacy": "node scripts/clean-desktop-generated-artifacts.mjs"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.11.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "^19.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "typescript": "5.9.3"
  }
}
