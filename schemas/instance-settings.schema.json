{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Localogue Instance Settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sharedPackPaths"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "libraryPath": {
      "type": "string"
    },
    "sharedPackPaths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "updatedAt": {
      "type": "string"
    },
    "mediaScanPaths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "ffprobePath": {
      "type": "string"
    }
  }
}
