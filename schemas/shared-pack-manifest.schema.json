{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Localogue Shared Pack Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "name",
    "version"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "shared-library"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "languages": {
      "type": "array",
      "items": {
        "enum": [
          "ja",
          "zh-CN",
          "en"
        ]
      },
      "uniqueItems": true
    },
    "license": {
      "type": "string"
    },
    "sourceUrl": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  }
}
