# Dependencies
node_modules/

# Next.js build output
.next/
out/

# Local environment files
.env
.env.*
!.env.example

# Local instance settings
.localogue/

# Logs
*.log

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Generated TypeScript build metadata
*.tsbuildinfo

# Localogue private/runtime data must not be committed.
# Public fictional examples live in data/demo-library/.
data/library/*
!data/library/.gitkeep
data/runtime/
data/backups/
data/imports/

# Re-creatable development fixtures / runtime scratch data
var/

# Future database files (V2+)
*.sqlite
*.sqlite3
*.db

# Tauri / Vite desktop build output
apps/desktop/dist/
apps/desktop/src-tauri/target/

# V1-13 legacy Vite config emit artifacts (never source files)
apps/desktop/vite.config.js
apps/desktop/vite.config.js.map
apps/desktop/vite.config.d.ts
apps/desktop/vite.config.d.ts.map
